{
  "name": "claude-codex-custom-buttons",
  "private": true,
  "version": "0.0.0",
  "description": "Reusable buttons and productivity widgets for Claude Code, Codex and Claude Desktop, with a Prompt Bank synced through Google Drive.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:links",
    "coverage": "vitest run --coverage",
    "ccb": "node packages/cli/dist/bin.js",
    "ccb-mcp": "node packages/mcp-server/dist/bin.js",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:plugin": "node scripts/build-plugin.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
